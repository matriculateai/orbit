# npm configuration for Senture Orbit frontend

# Enable legacy peer dependencies to avoid conflicts with react-scripts
legacy-peer-deps=true

# Strict SSL (set to false only if behind corporate proxy)
strict-ssl=true

# Save exact versions in package.json
save-exact=false

# Engine strict (enforce Node.js version requirements)
engine-strict=false

# Fund messages
fund=false

# Audit level (show security vulnerabilities)
audit-level=moderate
