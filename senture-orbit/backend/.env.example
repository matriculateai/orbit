# Senture Orbit Backend Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=Senture Orbit API
APP_VERSION=2.0.0
DEBUG=false

# ==========================================
# Supabase PostgreSQL Configuration
# ==========================================
# IMPORTANT: Use port 6543 (connection pooler) for production, NOT 5432
POSTGRES_HOST=db.xxxxxxxxxxxxx.supabase.co
POSTGRES_PORT=6543
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-supabase-password-here
POSTGRES_POOL_MIN_SIZE=5
POSTGRES_POOL_MAX_SIZE=20
POSTGRES_COMMAND_TIMEOUT=30
POSTGRES_SSL_MODE=require

# ==========================================
# Redis Cache Configuration
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=3600

# ==========================================
# Qdrant Vector DB Configuration (for RAG)
# ==========================================
# Two connection modes supported:
#
# Option 1: Qdrant Cloud (recommended for production)
# - Set QDRANT_URL and QDRANT_API_KEY
# - Leave QDRANT_HOST empty or comment it out
QDRANT_URL=https://xyz-example.us-east.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here
#
# Option 2: Local Qdrant (for development)
# - Leave QDRANT_URL empty
# - Set QDRANT_HOST and QDRANT_PORT
# QDRANT_URL=
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_API_KEY=  # Optional for local mode
#
# Collection settings (applies to both modes)
QDRANT_COLLECTION=query_history
QDRANT_VECTOR_SIZE=384

# ==========================================
# Claude AI Configuration (Anthropic)
# ==========================================
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_HAIKU_MODEL=claude-3-5-haiku-20241022
CLAUDE_SONNET_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096

# ==========================================
# Query Processing Settings
# ==========================================
QUERY_COMPLEXITY_THRESHOLD=0.6
RAG_TOP_K=3
ENABLE_QUERY_CACHING=true

# ==========================================
# SQL Security Settings
# ==========================================
# Maximum SQL query length in characters (prevent DoS attacks)
SQL_MAX_QUERY_LENGTH=50000
# Maximum number of rows returned per query (prevent memory exhaustion)
SQL_MAX_RESULT_ROWS=10000
# Enable SQL validation (should always be true in production)
SQL_ENABLE_VALIDATION=true
# Allowed database schemas (comma-separated)
SQL_ALLOWED_SCHEMAS=["dim","fact","agg","information_schema"]

# ==========================================
# CORS Configuration
# ==========================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
