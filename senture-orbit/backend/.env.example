# Senture Orbit Backend Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=Senture Orbit API
APP_VERSION=1.0.0
DEBUG=false

# =============================================================================
# Databricks Configuration
# =============================================================================
# Authentication is handled automatically by the Databricks SDK.
# The SDK uses the default credential provider chain:
# 1. Environment variables (DATABRICKS_HOST, DATABRICKS_TOKEN)
# 2. Databricks CLI profiles (~/.databrickscfg)
# 3. Azure/GCP/AWS native auth in cloud environments
# 4. Workspace auth in Databricks Apps (automatic)

# For LOCAL DEVELOPMENT, set these environment variables:
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi_your_token_here

# SQL Warehouse configuration (one of these is required):
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your_warehouse_id
# OR
# DATABRICKS_WAREHOUSE_ID=your_warehouse_id

# Database Configuration
DATABRICKS_CATALOG=pharma_gold
DATABRICKS_SCHEMA=gold

# =============================================================================
# Genie AI Configuration
# =============================================================================
GENIE_ENABLED=true
GENIE_SPACE_ID=your-genie-space-id

# =============================================================================
# Claude AI (Anthropic) Configuration
# =============================================================================
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096

# =============================================================================
# CORS Configuration
# =============================================================================
# For local development:
CORS_ORIGINS=["http://localhost:3000"]

# In Databricks Apps, the frontend is served from the same origin,
# so CORS is typically not an issue.

# =============================================================================
# Static Files (for Databricks Apps)
# =============================================================================
# Path to serve frontend static files from
# In Databricks Apps, the frontend is built and copied here
STATIC_FILES_PATH=/app/static

# =============================================================================
# Optional: Redis (for caching)
# =============================================================================
REDIS_URL=redis://localhost:6379
