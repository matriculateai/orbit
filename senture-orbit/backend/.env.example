# Senture Orbit Backend Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=Senture Orbit API
APP_VERSION=1.0.0
DEBUG=false

# =============================================================================
# Databricks Configuration
# =============================================================================

# For LOCAL DEVELOPMENT (with explicit credentials):
# Set these when running outside of Databricks Apps
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi_your_token_here
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your_warehouse_id

# Alternatively, you can specify just the warehouse ID:
# DATABRICKS_WAREHOUSE_ID=your_warehouse_id

# For DATABRICKS APPS deployment:
# - DATABRICKS_HOST and DATABRICKS_TOKEN are not needed (uses workspace auth)
# - Set IS_DATABRICKS_APPS=true or the app will auto-detect
# IS_DATABRICKS_APPS=true

# Database Configuration
DATABRICKS_CATALOG=pharma_gold
DATABRICKS_SCHEMA=gold

# =============================================================================
# Genie AI Configuration
# =============================================================================
GENIE_ENABLED=true
GENIE_SPACE_ID=your-genie-space-id

# =============================================================================
# Claude AI (Anthropic) Configuration
# =============================================================================
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096

# =============================================================================
# CORS Configuration
# =============================================================================
# For local development:
CORS_ORIGINS=["http://localhost:3000"]

# For Databricks Apps, additional origins are added automatically
# based on the workspace domain

# =============================================================================
# Static Files (for Databricks Apps)
# =============================================================================
# Path to serve frontend static files from
# In Databricks Apps, the frontend is built and copied here
STATIC_FILES_PATH=/app/static

# =============================================================================
# Optional: Redis (for caching)
# =============================================================================
REDIS_URL=redis://localhost:6379
